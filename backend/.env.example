# Copy this file to `.env` and fill in real values.
#   cp .env.example .env   (or on Windows: copy .env.example .env)

# Groq API key (free tier). Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Which Groq model to use for extraction (default: openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# Django secret key — set a long random value in production
# DJANGO_SECRET_KEY=